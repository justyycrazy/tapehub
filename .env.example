# tapehub 服务配置示例（pydantic-settings，环境变量前缀 TAPEHUB_）。
# 复制为 .env 使用；.env 不得提交到版本库。

# 服务版本与 API 版本（出现在 /health 响应中）
TAPEHUB_VERSION=0.1.0
TAPEHUB_API_VERSION=v1

# 能力目录版本（出现在 /v1/capabilities 的 meta 中）
TAPEHUB_CATALOG_VERSION=1

# 统一分页的最大 limit
TAPEHUB_MAX_LIMIT=5000

# 以 JSON 对象覆盖 Provider 启用状态（键为 manifest 中的 provider 名）。
# 注意：把未实现的 Provider 置为 enabled 后，请求会返回 PROVIDER_NOT_IMPLEMENTED。
TAPEHUB_PROVIDER_ENABLED_OVERRIDES={}

# Provider 凭据示例（真实凭据只能通过环境变量或密钥管理系统提供，
# 禁止写入代码、manifest.yaml、日志、异常响应或测试 fixture）。
# TickFlow：REST API + 官方 Python SDK（可选依赖 tickflow），
# 未配置时能力目录不受影响，数据请求返回 PROVIDER_NOT_IMPLEMENTED。
TAPEHUB_TICKFLOW_API_KEY=
# AlphaFeed：REST API + 官方 Python SDK（可选依赖 alphafeed），约定同上。
TAPEHUB_ALPHAFEED_API_KEY=
# Tushare：官方 Python SDK（可选依赖 tushare），Token 即 Tushare 积分凭据；
# 未配置时能力目录不受影响，数据请求返回 PROVIDER_NOT_IMPLEMENTED。
TAPEHUB_TUSHARE_TOKEN=
# TqSdk：官方 Python SDK（可选依赖 tqsdk），需要快期账户（TqAuth）
# 的用户名/邮箱与密码，两者必须同时配置。
TAPEHUB_TQSDK_AUTH_USER=
TAPEHUB_TQSDK_AUTH_PASSWORD=
# Twelve Data：官方 Python 库（可选依赖 twelvedata），API Key 即账户凭据。
TAPEHUB_TWELVEDATA_API_KEY=
