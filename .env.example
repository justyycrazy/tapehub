# tapehub 服务配置示例（pydantic-settings，环境变量前缀 TAPEHUB_）。
# 复制为 .env 使用；.env 不得提交到版本库。

# 服务版本与 API 版本（出现在 /health 响应中）
TAPEHUB_VERSION=0.1.0
TAPEHUB_API_VERSION=v1

# 能力目录版本（出现在 /v1/capabilities 的 meta 中）
TAPEHUB_CATALOG_VERSION=1

# 部署模式守门字段：当前版本仅支持 single（单进程、单用户最小运行模式）。
# 其他值会在服务启动时直接失败（cluster 计划随多进程需求落地后提供）。
TAPEHUB_DEPLOYMENT_MODE=single

# 交互式文档开关（/docs、/redoc、/openapi.json）：本地调试默认开启；
# 对外（非回环）暴露前建议置 false（API 结构不向非可信主体披露）
TAPEHUB_DOCS_ENABLED=true

# 统一分页的最大 limit
TAPEHUB_MAX_LIMIT=5000
# 入站 API Key 白名单（JSON 数组）：非空即启用全部业务端点的 X-Api-Key
# 校验（缺失/不匹配返回 401；/health 保持无鉴权）。留空 = 无鉴权（single
# 模式设计边界）——对外（非回环）暴露前必须配置，见 operations.md 安全边界
TAPEHUB_API_KEYS=[]

# 入站客户端限流（每身份每 60 秒窗口请求数上限）：0 = 关闭（默认）。
# 身份为命中白名单的 API Key（未命中一律归 anonymous，桶数上界 =
# len(API_KEYS)+1）；超限 429 CLIENT_RATE_LIMITED + Retry-After；/health
# 豁免。保护上游付费配额（对外暴露或配额敏感时建议启用）
TAPEHUB_CLIENT_RATE_LIMIT_PER_MINUTE=0

# 以 JSON 对象覆盖 Provider 启用状态（键为 manifest 中的 provider 名）。
# 显式覆盖优先于凭据推断：false 强制禁用；true 为逃生门（可越过凭据推断强制启用，
# 启动日志告警，请求仍可能因凭据/SDK 缺失失败）。把未实现的 Provider 置为 enabled
# 后，请求会返回 PROVIDER_NOT_IMPLEMENTED。
TAPEHUB_PROVIDER_ENABLED_OVERRIDES={}
# 缺省路由顺序配置（provider_routing.yaml）：跨 Provider 能力冲突的集中裁决
# （每个 data_type × market × asset_type 组合的完整回退链）。留空用包内内置版本；
# 指定路径时外部文件整体替换内置版本，不做合并。
#TAPEHUB_ROUTING_CONFIG_PATH=

# Provider 凭据示例（真实凭据只能通过环境变量或密钥管理系统提供，
# 禁止写入代码、manifest.yaml、日志、异常响应或测试 fixture）。
# TickFlow：REST API + 官方 Python SDK（可选依赖 tickflow）。
# 凭据驱动的注册：未配置时该 Provider 不启用（能力目录仍可见但 enabled=false，
# auto 路由跳过；显式请求返回 PROVIDER_DISABLED）。
TAPEHUB_TICKFLOW_API_KEY=
# AlphaFeed：REST API + 官方 Python SDK（可选依赖 alphafeed），约定同上。
TAPEHUB_ALPHAFEED_API_KEY=
# Tushare：官方 Python SDK（可选依赖 tushare），Token 即 Tushare 积分凭据，约定同上。
TAPEHUB_TUSHARE_TOKEN=
# TqSdk：官方 Python SDK（可选依赖 tqsdk），需要快期账户（TqAuth）
# 的用户名/邮箱与密码，两者必须同时配置（任一缺失即不启用）。
TAPEHUB_TQSDK_AUTH_USER=
TAPEHUB_TQSDK_AUTH_PASSWORD=
# tqsdk 连接模式：shared（进程内唯一长连接 Runtime，首次请求懒启动，
# 2026-11-05 15.3h 观察期验证后为默认；实测每请求节省 ~1s 建连）/
# per_request（每请求独立实例，回滚配置）
TAPEHUB_TQSDK_CONN_MODE=shared
# shared 模式在飞取数上限（并发闸门，超出返回 CONCURRENCY_LIMIT 429）
TAPEHUB_TQSDK_MAX_INFLIGHT_FETCH=16
# 实时快照首包等待超时（秒）：订阅建立后上游未推送首包即返回
# QUOTE_NOT_READY（HTTP 408）。常见于标的不存在/无权限或非交易时段上游静默
TAPEHUB_TQSDK_FIRST_SNAPSHOT_TIMEOUT=5
# 休眠订阅回收阈值：tqsdk 不支持取消订阅，退订只停止本地快照维护；
# 休眠订阅累计到该值触发新一代重建清理（仍被引用的订阅自动重订）
TAPEHUB_TQSDK_SUBSCRIPTION_LIMIT=64

# —— 实时行情流（SSE，GET /v1/market/quotes/stream）——
# 并发流客户端上限（超出返回 STREAM_LIMIT_REACHED 429）
TAPEHUB_STREAM_MAX_CLIENTS=8
# 每客户端事件缓冲长度（仅约束 quote 帧：满时丢旧保新，
# status 生命周期事件绝不丢弃——行情「最新」比「完整」有价值）
TAPEHUB_STREAM_QUEUE_SIZE=64
# 空闲心跳间隔（秒）：无事件时按该周期发送保活帧
TAPEHUB_STREAM_HEARTBEAT_SECONDS=15
# 流空闲超时（秒）：该窗口内无行情事件（心跳不算）则本地退订并结束流
TAPEHUB_STREAM_IDLE_TIMEOUT_SECONDS=300
# 上游调用整体超时（秒）：bars/quotes 单次请求上限，超时返回 504
# UPSTREAM_TIMEOUT（SSE 流为长驻设计不适用此值）
TAPEHUB_UPSTREAM_TIMEOUT_SECONDS=30
# 全局线程池容量（anyio 默认 limiter）：TAPEHUB_THREAD_POOL_SIZE_MAP 为空
# 时全部线程型上游调用共享；非空时该值仅覆盖不经适配器分组路径的线程调用。
# 挂死调用被取消/超时后名额立即释放，孤儿线程不占名额但 OS 线程不被回收
# （上游 socket 无超时属 SDK 限制）
TAPEHUB_THREAD_POOL_SIZE=40
# 按 Provider 分组线程池容量（JSON 对象）：非空即开启分组隔离——每家
# Provider 独享名额池（列出者用配置容量，未列出者统一默认 4；10 家合计
# 恰为全局默认 40，开启分组不改变总在飞预算）。单家上游挂死/慢响应的
# 名额压力隔离在本家池内，其余 Provider 照常服务；本家池满快速返回
# CONCURRENCY_LIMIT（429，可重试），应用层超时兜底 UPSTREAM_TIMEOUT（504）。
# 未知 Provider 名仅启动告警不阻断。空 = 关闭分组（行为与历史版本一致）
TAPEHUB_THREAD_POOL_SIZE_MAP={}

# Twelve Data：官方 Python 库（可选依赖 twelvedata）+ websockets（实时流），
# API Key 即账户凭据。
TAPEHUB_TWELVEDATA_API_KEY=
# WS 并发订阅 symbol 上限（探针实证免费版 8 个 WS credit；升档后调大）
TAPEHUB_TWELVEDATA_SUBSCRIPTION_LIMIT=8
# 实时快照冷订阅首包等待超时（秒），超时返回 QUOTE_NOT_READY 408
TAPEHUB_TWELVEDATA_FIRST_SNAPSHOT_TIMEOUT=5

# Tiingo：REST + WS 直连（可选依赖 tiingo 组：httpx + websockets），
# API Key 即账户凭据（免费档限额：50 请求/时、1000 请求/天、500 唯一品种/月、
# 1GB 带宽/月——WS 不计请求数只计带宽，详见 README）
TAPEHUB_TIINGO_API_KEY=
# WS 并发订阅 symbol 软上限（上游未公布并发上限，默认 8 防失控；
# 上游硬约束为月度 500 个唯一品种，网关不做计数）
TAPEHUB_TIINGO_SUBSCRIPTION_LIMIT=8
# 实时快照冷订阅首包等待超时（秒），超时返回 QUOTE_NOT_READY 408
TAPEHUB_TIINGO_FIRST_SNAPSHOT_TIMEOUT=5

# 同花顺金融数据 API（ths）：纯 REST 直连（可选依赖 ths 组：httpx），
# X-api-key 请求头认证（文档站「API Key 管理」页签发，详见 README）
TAPEHUB_THS_API_KEY=

# 富途 OpenAPI（futunn）：纯 REST 直连（可选依赖 futunn 组：httpx +
# cryptography），「方式二：传统 API Key」签名认证——open.futunn.com/dashboard
# 控制台「AppKey 管理」创建 AppKey 并上传公钥（Ed25519 或 RSA-SHA256），
# 这里填 AppKey ID 与与其配对的本地私钥 PEM 文件路径（两者必须同时配置，
# 任一缺失即不启用；凭据驱动的注册语义同上，详见 README）
TAPEHUB_FUTUNN_APP_KEY=
TAPEHUB_FUTUNN_PRIVATE_KEY_PATH=
