# tapehub 服务配置示例（pydantic-settings，环境变量前缀 TAPEHUB_）。
# 复制为 .env 使用；.env 不得提交到版本库。

# 服务版本与 API 版本（出现在 /health 响应中）
TAPEHUB_VERSION=0.1.0
TAPEHUB_API_VERSION=v1

# 能力目录版本（出现在 /v1/capabilities 的 meta 中）
TAPEHUB_CATALOG_VERSION=1

# 统一分页的最大 limit
TAPEHUB_MAX_LIMIT=5000

# 以 JSON 对象覆盖 Provider 启用状态（键为 manifest 中的 provider 名）。
# 注意：把未实现的 Provider 置为 enabled 后，请求会返回 PROVIDER_NOT_IMPLEMENTED。
TAPEHUB_PROVIDER_ENABLED_OVERRIDES={}

# Provider 凭据示例（第一版代码不读取以下变量，仅作约定示意）。
# 真实凭据只能通过环境变量或未来密钥管理系统提供，
# 禁止写入代码、manifest.yaml、日志、异常响应或测试 fixture。
# TAPEHUB_TUSHARE_TOKEN=
